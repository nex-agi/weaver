[MASTER]
ignore=tests,wandb,dist,build,.git
ignore-patterns=test_.*?\.py

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    fixme,
    import-error,
    no-member,
    too-many-branches,
    too-many-statements,
    broad-except,
    duplicate-code,
    import-outside-toplevel

[FORMAT]
max-line-length=100

[BASIC]
good-names=i,j,k,ex,_,id

[DESIGN]
max-args=10
max-attributes=15
